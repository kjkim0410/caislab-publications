      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>wireless sensor networks; authentication; mobile node; untraceability; key distribution</pdf:Keywords>
         <pdf:Producer>pdfTeX-1.40.9</pdf:Producer>
         <pdf:Trapped>Unknown</pdf:Trapped>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/">
         <pdfx:PTEX.Fullbanner>This is MiKTeX-pdfTeX 2.7.3235 (1.40.9)</pdfx:PTEX.Fullbanner>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/">
         <xmpRights:Marked>False</xmpRights:Marked>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Kyusuk Han</rdf:li>
               <rdf:li>Kwangjo Kim</rdf:li>
               <rdf:li>Taeshik Shon</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mobility of sensor node in Wireless Sensor Networks (WSN) brings security issues such as re-authentication and tracing the node movement. However, current security researches on WSN are insufficient to support such environments since their designs only considered the static environments. In this paper, we propose the efficient node authentication and key exchange protocol that reduces the overhead in node re-authentication and also provides untraceability of mobile nodes. Compared with previous protocols, our protocol has only a third of communication and computational overhead. We expect our protocol to be the efficient solution that increases the lifetime of sensor network.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Untraceable Mobile Node Authentication in WSN</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>wireless sensor networks</rdf:li>
               <rdf:li>authentication</rdf:li>
               <rdf:li>mobile node</rdf:li>
               <rdf:li>untraceability</rdf:li>
               <rdf:li>key distribution</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmpMM:DocumentID>uuid:06e85516-297d-444f-ba7d-509e6acb505a</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:21d202ef-47cd-4051-94b6-04b8385d58f3</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
